{
  "manifest_version": 3,
  "name": "Mime",
  "version": "1.0.0",
  "description": "Minimalist off-black and paper-white two-button calendar and reminders.",
  "permissions": [
    "storage",
    "notifications"
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Mime",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}